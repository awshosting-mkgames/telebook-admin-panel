# Backend ka pata — "/api/admin" ke BINA (woh panel khud jodta hai).
#
#  Yeh build ke waqt code me chala jaata hai, isliye badalne par panel
#  dobara build karna padta hai (npm run build). Dev me `npm start` dobara
#  chalaiye.
#
#  Khali chhod dein to panel usi jagah se API maangta hai jahan se woh khud
#  khula hai — yeh tab theek hai jab panel aur backend ek hi domain par hon.
VITE_API_BASE_URL=https://api.telebookservices.com

# DHYAN: isme koi raaz mat rakhiye. Vite har VITE_* variable ko build me
# chipka deta hai — woh panel kholne wale har aadmi ko dikh jaata hai.
# Secret (DB password, JWT secret, keys) backend ki .env me rehte hain.
